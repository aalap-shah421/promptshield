{
  "version": "0.1.0",
  "patterns": [
    {"id": "instr_override_001", "name": "ignore previous instructions",      "regex": "(?i)ignore (?:all )?(?:previous|prior|the above) (?:instructions?|prompts?|rules?)", "weight": 35, "category": "instruction_override"},
    {"id": "instr_override_002", "name": "disregard previous",                 "regex": "(?i)disregard (?:all )?(?:previous|prior) (?:instructions?|prompts?)",         "weight": 30, "category": "instruction_override"},
    {"id": "instr_override_003", "name": "forget previous",                    "regex": "(?i)forget (?:all )?(?:previous|prior|everything you)",                        "weight": 25, "category": "instruction_override"},
    {"id": "instr_override_004", "name": "new instructions follow",            "regex": "(?i)(?:new|updated|revised) (?:instructions?|prompts?) (?:are|follow)",       "weight": 20, "category": "instruction_override"},
    {"id": "role_confusion_001", "name": "you are now",                        "regex": "(?i)you (?:are|will be) now (?:an?|the) ",                                     "weight": 25, "category": "role_confusion"},
    {"id": "role_confusion_002", "name": "act as system",                      "regex": "(?i)act as (?:the )?(?:system|admin|root|developer|jailbroken)",              "weight": 35, "category": "role_confusion"},
    {"id": "role_confusion_003", "name": "DAN jailbreak",                      "regex": "(?i)\\b(?:DAN|do anything now|developer mode)\\b",                            "weight": 40, "category": "role_confusion"},
    {"id": "role_confusion_004", "name": "pretend you have no restrictions",   "regex": "(?i)pretend (?:you (?:have|are)|that you (?:have|are)) no (?:restrictions?|rules?|guidelines?)", "weight": 35, "category": "role_confusion"},
    {"id": "system_leak_001",    "name": "what is your system prompt",         "regex": "(?i)(?:what (?:is|are)|show me|reveal|print|output) (?:your )?(?:system )?(?:prompt|instructions|rules|directives)", "weight": 30, "category": "exfiltration"},
    {"id": "system_leak_002",    "name": "repeat the words above",             "regex": "(?i)repeat (?:the )?(?:words|content|text) (?:above|prior|before this)",        "weight": 25, "category": "exfiltration"},
    {"id": "system_leak_003",    "name": "print verbatim",                     "regex": "(?i)print (?:verbatim|exactly|word for word) ",                                "weight": 20, "category": "exfiltration"},
    {"id": "system_leak_004",    "name": "request system prompt",              "regex": "(?i)(?:tell me|give me|show) your (?:initial|original|hidden) (?:prompt|instructions)", "weight": 35, "category": "exfiltration"},
    {"id": "encoding_001",       "name": "base64 payload (long)",              "regex": "[A-Za-z0-9+/]{60,}={0,2}",                                                     "weight": 15, "category": "encoded_payload"},
    {"id": "encoding_002",       "name": "rot13 marker",                       "regex": "(?i)\\bROT-?13\\b|\\b(rot|caesar) cipher\\b",                                 "weight": 10, "category": "encoded_payload"},
    {"id": "encoding_003",       "name": "hex blob",                           "regex": "(?:\\\\x[0-9a-fA-F]{2}){8,}",                                                  "weight": 15, "category": "encoded_payload"},
    {"id": "encoding_004",       "name": "unicode escapes blob",               "regex": "(?:\\\\u[0-9a-fA-F]{4}){8,}",                                                  "weight": 15, "category": "encoded_payload"},
    {"id": "delim_break_001",    "name": "fake closing tag",                   "regex": "(?i)</?(?:system|instruction|prompt|user|assistant)>",                         "weight": 25, "category": "delimiter_attack"},
    {"id": "delim_break_002",    "name": "markdown code-fence injection",      "regex": "```\\s*(?:system|instruction|prompt)",                                         "weight": 20, "category": "delimiter_attack"},
    {"id": "delim_break_003",    "name": "triple backtick + role",             "regex": "```[a-z]*\\nyou are",                                                          "weight": 25, "category": "delimiter_attack"},
    {"id": "indirect_001",       "name": "tool-output injection marker",       "regex": "(?i)\\[\\s*(?:assistant|system)\\s+says\\s*\\]",                              "weight": 25, "category": "indirect_injection"},
    {"id": "indirect_002",       "name": "data: URI exfil",                    "regex": "data:(?:text|application)/[^;,]+(?:;base64)?,",                                "weight": 20, "category": "indirect_injection"},
    {"id": "indirect_003",       "name": "hidden image-alt instruction",       "regex": "(?i)alt\\s*=\\s*[\"'](?:ignore|forget|new instructions)",                      "weight": 25, "category": "indirect_injection"},
    {"id": "policy_001",         "name": "harmful content request marker",     "regex": "(?i)how to (?:make|build|synthesize) (?:a )?(?:bomb|explosive|weapon|virus)",  "weight": 50, "category": "policy_violation"},
    {"id": "policy_002",         "name": "bypass safety",                      "regex": "(?i)bypass (?:your )?(?:safety|content|moderation) (?:filters?|policies?|rules?)", "weight": 40, "category": "policy_violation"},
    {"id": "obfusc_001",         "name": "leetspeak ignore",                   "regex": "(?i)\\b1gn[o0]r[e3]\\b",                                                       "weight": 25, "category": "obfuscation"},
    {"id": "obfusc_002",         "name": "spaced-out ignore",                  "regex": "(?i)i\\s+g\\s+n\\s+o\\s+r\\s+e",                                              "weight": 20, "category": "obfuscation"},
    {"id": "obfusc_003",         "name": "zero-width chars",                   "regex": "[\\u200b-\\u200f\\u2028-\\u202f]",                                              "weight": 15, "category": "obfuscation"},
    {"id": "lang_switch_001",    "name": "translate to bypass",                "regex": "(?i)translate (?:the following |this |everything )?(?:to|into) (?:[a-z]+) and (?:then |)(?:execute|do|follow)", "weight": 25, "category": "language_switch"},
    {"id": "tool_abuse_001",     "name": "self-tool invocation",               "regex": "(?i)<(?:tool|function)_call>",                                                 "weight": 20, "category": "tool_abuse"},
    {"id": "tool_abuse_002",     "name": "fake tool response",                 "regex": "(?i)<(?:tool|function)_response>",                                             "weight": 25, "category": "tool_abuse"},
    {"id": "social_001",         "name": "developer claim",                    "regex": "(?i)(?:I am|this is) (?:the |your )?(?:developer|engineer|admin|owner)",       "weight": 20, "category": "social_engineering"},
    {"id": "social_002",         "name": "urgent override",                    "regex": "(?i)(?:urgent|emergency|critical):? (?:override|bypass|ignore)",               "weight": 25, "category": "social_engineering"}
  ]
}
